{
  "expo": {
    "name": "GruuvyPay",
    "slug": "gruuvypay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gruuvypay",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4FD8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gruuvy.gruuvypay",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "GruuvyPay needs camera access to scan QR codes and upload KYC documents.",
        "NSPhotoLibraryUsageDescription": "GruuvyPay needs photo library access to upload KYC documents.",
        "NSPhotoLibraryAddUsageDescription": "GruuvyPay needs permission to save receipts to your photos.",
        "NSFaceIDUsageDescription": "GruuvyPay uses Face ID to keep your account secure.",
        "NSContactsUsageDescription": "GruuvyPay needs contacts access to quickly find people to pay."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4FD8"
      },
      "package": "com.gruuvy.gruuvypay",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B4FD8",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "GruuvyPay"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GruuvyPay uses Face ID to keep your account secure."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GruuvyPay needs photo library access to upload KYC documents.",
          "cameraPermission": "GruuvyPay needs camera access to scan QR codes and upload KYC documents."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}